# Shared by web, collab, worker. Copy to .env at repo root.
DATABASE_URL=postgres://corpus:corpus@localhost:5432/corpus

# Public URL of the web app
PUBLIC_APP_URL=http://localhost:5173
# Websocket URL of the collab server (notes)
PUBLIC_COLLAB_URL=ws://localhost:1234
COLLAB_PORT=1234

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# 32-byte key, base64 — encrypts integration tokens: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# Who can manage integration OAuth apps in the UI (comma-separated). Unset = first user.
ADMIN_EMAILS=

# OAuth apps below are optional here: an admin can enter them on the Integrations page
# instead (stored encrypted). Values set here take precedence. GitHub and Linear users can
# also connect with a personal token, no OAuth app needed.

# GitHub OAuth app (sign-in + integration). Sign-in only reads these env vars. Callback URLs:
#   {PUBLIC_APP_URL}/api/auth/callback/github
#   {PUBLIC_APP_URL}/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linear OAuth app. Callback: {PUBLIC_APP_URL}/integrations/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Google Calendar two-way sync (Google Cloud OAuth client, type "Web application",
# Google Calendar API enabled). Redirect URI: {PUBLIC_APP_URL}/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (user token scopes are requested automatically). Redirect URL:
#   {PUBLIC_APP_URL}/integrations/slack/callback   — Slack requires https, so use a tunnel in dev
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Email (Mailpit in dev)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Corpus <no-reply@corpus.local>"

# Web push — generate with: pnpm dlx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@corpus.local

# Uploads (notes images) — local dir
UPLOAD_DIR=./uploads
