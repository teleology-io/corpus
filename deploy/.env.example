# Copy to deploy/.env (git-ignored) and fill in. Used by deploy/compose.yml.
# Generate secrets with: openssl rand -base64 32

POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me
ENCRYPTION_KEY=change-me

# Public URLs as the browser sees them (put a TLS proxy in front for real deployments).
PUBLIC_APP_URL=http://localhost:2222
PUBLIC_COLLAB_URL=ws://localhost:1234
ADMIN_URL=http://localhost:2223

# Host ports. Change these to run next to `make dev` (which uses 2222 / 2223 / 1234).
WEB_PORT=2222
ADMIN_PORT=2223
COLLAB_PORT=1234

# Optional: OAuth apps, SMTP, web push, R2 — same meaning as the root .env.example.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# STORAGE_DRIVER=r2
