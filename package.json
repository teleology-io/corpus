{
	"name": "corpus",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"dev": "concurrently -n web,collab,worker -c blue,magenta,yellow \"pnpm --filter web dev\" \"pnpm --filter @corpus/collab dev\" \"pnpm --filter @corpus/worker dev\"",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"test": "pnpm -r test",
		"db:generate": "pnpm --filter @corpus/db generate",
		"db:migrate": "pnpm --filter @corpus/db migrate",
		"db:studio": "pnpm --filter @corpus/db studio",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"typescript": "^6.0.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0"
	}
}
